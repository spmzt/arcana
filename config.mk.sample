# Copy to config.mk to override build settings for this machine.

# Use another linker, e.g. when the base ld.lld is broken:
#LDFLAGS+=	--ld-path=/usr/local/llvm21/bin/ld.lld

# cblink comes from the submodule cblink/ and is built with the tree.
# To use an installed one instead (devel/cblink's, or a copy), say where
# it is; with an rpath so the programs find libcblink.so there:
#CBLINK_PREFIX=	/path/to/cblink-root/usr/local
#LDFLAGS+=	-Wl,-rpath,${CBLINK_PREFIX}/lib

# libwebsockets, if not installed in ${LOCALBASE} (net/libwebsockets):
#LWS_CFLAGS=	-I/path/to/libwebsockets/include
#LWS_LIBS=	-L/path/to/libwebsockets/lib -lwebsockets

# The network map's WebGPU, off by default (WebGL 2 draws it then); it
# needs Dawn's emdawnwebgpu package, which "make depends" fetches.
# "make config" sets this and WITHOUT_CONSOLE in a block of its own:
#WITH_WEBGPU=	yes

# Dawn's emdawnwebgpu package, with WITH_WEBGPU, if not where "make
# depends" puts it: its port file, from the zip of a Dawn release, or
# emdawnwebgpu for emcc to fetch it at build time (that needs the network):
#EMDAWN=	/path/to/emdawnwebgpu_pkg/emdawnwebgpu.port.py
