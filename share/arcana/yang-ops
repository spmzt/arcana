# The operations of arcana.yaml converted to YANG (PLAN-SDN-YANG Y-3),
# and the module each is now: an operation's task shows the module's
# tree (RFC 8340) beside its CBOR schema.  One a line: operation, then
# module@revision, a module of share/yang.
list	arcana-jails@2026-10-14
action	arcana-jails@2026-10-14
services	arcana-services@2026-10-14
service-action	arcana-services@2026-10-14
service-config	arcana-services@2026-10-14
packages	arcana-packages@2026-10-14
pkg-upgrade	arcana-packages@2026-10-14
job-submit	arcana-jobs@2026-10-14
jobs	arcana-jobs@2026-10-14
job	arcana-jobs@2026-10-14
job-cancel	arcana-jobs@2026-10-14
job-confirm	arcana-jobs@2026-10-14
jobs-set	arcana-jobs@2026-10-14
storage	arcana-storage@2026-10-14
fstab	arcana-storage@2026-10-14
zfs-send	arcana-storage@2026-10-14
zfs-receive	arcana-storage@2026-10-14
zfs-key	arcana-storage@2026-10-14
sysctl	arcana-sysctl@2026-10-14
sysctl-parts	arcana-sysctl@2026-10-14
kernel	arcana-kernel@2026-10-14
processes	arcana-processes@2026-10-14
log	arcana-log@2026-10-14
ipfw-rules	arcana-firewall@2026-10-15
fw-trace	arcana-firewall@2026-10-15
path-check	arcana-troubleshoot@2026-10-15
traceroute	arcana-troubleshoot@2026-10-15
capture	arcana-troubleshoot@2026-10-15
history	arcana-history@2026-10-15
events	arcana-events@2026-10-15
event	arcana-events@2026-10-15
bird-config	arcana-bird@2026-10-15
# hello stays an operation (how a console reaches an agent of an
# earlier release); its host and the stats are arcana-host's host, the
# certs its read-certificates action.
hello	arcana-host@2026-10-15
stats	arcana-host@2026-10-15
certs	arcana-host@2026-10-15
# agent-update, agent-build, console-update and source-head stay
# operations (the fleet's update); source-log, config-export and
# config-apply are arcana-agent's actions, transport and tls its state
# with their actions.
agent-update	arcana-agent@2026-10-15
agent-build	arcana-agent@2026-10-15
console-update	arcana-agent@2026-10-15
source-head	arcana-agent@2026-10-15
source-log	arcana-agent@2026-10-15
transport	arcana-agent@2026-10-15
tls	arcana-agent@2026-10-15
config-export	arcana-agent@2026-10-15
config-apply	arcana-agent@2026-10-15
# jail-files: the read-files action on arcana-jails' jails.
jail-files	arcana-jail-files@2026-10-15
sdwan-probes	arcana-probe@2026-10-15
# sdwan's read arcana-sdwan's state with arcana-probe's targets; the
# parts (rules, steer, bird, dhcp, dns, proxy, ids) an edge's in
# arcana-sdwan by EDIT and a commit, the same sent again its apply.
sdwan	arcana-sdwan@2026-10-15
sdwan-rules	arcana-sdwan@2026-10-15
sdwan-steer	arcana-sdwan@2026-10-15
sdwan-bird	arcana-sdwan@2026-10-15
sdwan-dhcp	arcana-sdwan@2026-10-15
sdwan-dns	arcana-sdwan@2026-10-15
sdwan-proxy	arcana-sdwan@2026-10-15
sdwan-ids	arcana-sdwan@2026-10-15
address	ietf-ip@2018-02-22
# network's interfaces; its netgraph, wireguard and bird kinds the read
# actions of arcana-netgraph, arcana-wireguard and arcana-bird, its
# bird-routes and bird-ospf kinds arcana-bird's routes and ospf.
network	arcana-interfaces@2026-10-14
network-parts	arcana-network-instance@2026-10-14
route-lookup	ietf-routing@2018-03-13
step	arcana-jobs@2026-10-14
steps	arcana-jobs@2026-10-14
ssh	arcana-sshd@2026-10-15
builder	arcana-builder@2026-10-17
builder-options	arcana-builder@2026-10-17
notify	arcana-notify@2026-10-17
