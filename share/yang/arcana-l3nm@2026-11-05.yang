          ordered-by user;
          description
            "A rooted-multipoint's roots.";
        }
        leaf-list leaf {
          type name;
          ordered-by user;
          description
            "A rooted-multipoint's leaves.";
        }
      }
      container intervals {
        presence "Its Performance Time Intervals.";
        description
          "SWVC Performance Time Intervals (§9.7).";
        leaf eval {
          type uint32 {
            range "100..86400000";
          }
          units "milliseconds";
          description
            "The evaluation interval.";
        }
        leaf arrival {
          type uint32 {
            range "1..86400000";
          }
          units "milliseconds";
          description
            "The arrival interval.";
        }
        leaf ir {
          type uint32 {
            range "1..86400000";
          }
          units "milliseconds";
          description
            "The Information Rate interval.";
        }
      }
      container bfd {
