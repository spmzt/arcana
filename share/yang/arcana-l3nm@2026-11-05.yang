            ordered-by user;
            description
              "SPORT.";
          }
          leaf-list dport {
            type afs-value;
            ordered-by user;
            description
              "DPORT.";
          }
          leaf-list sdport {
            type afs-value;
            ordered-by user;
            description
              "SDPORT.";
          }
          leaf-list ethertype {
            type uint16 {
              range "1536..65535";
            }
            ordered-by user;
            description
              "ETHERTYPE.";
          }
          leaf-list appid {
            type string;
            ordered-by user;
            description
              "APPID.";
          }
          leaf src-list {
            type string;
            description
              "A named list of prefixes, SAV4 and SAV6.";
          }
          leaf dst-list {
            type string;
            description
              "A named list of prefixes, DAV4 and DAV6.";
          }
          leaf sdst-list {
            type string;
            description
              "A named list of prefixes, SDAV4 and SDAV6.";
          }
          leaf service-list {
            type string;
            description
              "A named list of services, PROTV4 and DPORT.";
          }
        }
      }
      list policy {
        key "name";
        ordered-by user;
        description
          "SWVC List of Policies (§9.12): its criteria are what the
