        leaf invalid-server-certificate {
          type enumeration {
            enum allow {
              description
                "Allow.";
            }
            enum block {
              description
                "Block.";
            }
          }
          description
            "MBSF (Table 9).";
        }
        leaf invalid-client-certificate {
          type enumeration {
            enum allow {
              description
                "Allow.";
            }
          }
          description
            "MBSF (Table 9).";
        }
        leaf unencrypted {
