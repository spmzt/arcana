            description
              "A named list of the UCSs it may take.";
          }
          leaf edge-list {
            type string;
            description
              "A named list of the edges it may go by.";
          }
          leaf ucs-end-point-list {
            type string;
            description
              "A named list of the UCS End Points it may take, in
               order.";
          }
          leaf encryption {
            type enumeration {
              enum required-always {
                description
                  "Always.";
              }
              enum required-public-only {
                description
                  "Over public UCSs.";
              }
              enum optional {
                description
                  "Optional.";
              }
            }
            description
              "ENCRYPTION.";
          }
          leaf public-private {
            type enumeration {
              enum private-only {
                description
                  "Private UCSs alone.";
              }
              enum either {
                description
                  "Either.";
              }
            }
            description
              "PUBLIC-PRIVATE.";
          }
          leaf internet-breakout {
            type enumeration {
              enum enabled {
                description
                  "Enabled.";
              }
              enum disabled {
                description
                  "Disabled.";
              }
            }
            description
              "INTERNET-BREAKOUT.";
          }
          leaf backup {
            type enumeration {
              enum enabled {
                description
                  "Enabled.";
              }
              enum disabled {
                description
                  "Disabled.";
              }
            }
            description
              "BACKUP.";
          }
          leaf billing-method {
            type enumeration {
              enum flat-rate-only {
                description
                  "Flat-rate UCSs alone.";
              }
              enum usage-based-only {
                description
                  "Usage-based UCSs alone.";
              }
              enum either {
                description
                  "Either.";
              }
            }
            description
              "BILLING-METHOD.";
          }
          leaf virtual-topology {
            type name;
            description
              "VIRTUAL-TOPOLOGY: Swvc or a topology (R47).";
          }
          container allowed-destination-zones {
            presence "ALLOWED-DESTINATION-ZONES said; none listed, none
                      (R59).";
            description
              "ALLOWED-DESTINATION-ZONES.";
            choice zones {
              description
                "All, or those listed.";
              leaf all {
                type empty;
                description
                  "All.";
              }
              leaf-list zone {
                type name;
                ordered-by user;
                description
                  "A zone, or Self.";
              }
            }
          }
          leaf business-importance {
            type name;
            description
              "BUSINESS-IMPORTANCE.";
          }
          container performance {
            presence "PERFORMANCE.";
            description
              "PERFORMANCE (Table 7): what arcana-steer's candidates
               are measured against.";
            container primary {
              description
                "The primary metric.";
              leaf metric {
                type enumeration {
                  enum delay {
                    description
                      "One-way delay.";
                  }
                  enum ipdv {
                    description
                      "Delay variation.";
                  }
                  enum loss {
                    description
                      "Loss ratio.";
                  }
                }
                description
                  "Which.";
              }
              leaf threshold {
                type metric-value;
                description
                  "The threshold.";
              }
              leaf ceiling {
                type metric-value;
                description
                  "The ceiling (R72).";
              }
              leaf remediation {
                type metric-value;
                description
                  "The remediation (R75, R76).";
              }
            }
            list secondary {
              key "metric";
              ordered-by user;
              description
                "A secondary metric.";
              leaf metric {
                type enumeration {
                  enum delay {
                    description
                      "One-way delay.";
                  }
                  enum ipdv {
                    description
                      "Delay variation.";
                  }
                  enum loss {
                    description
                      "Loss ratio.";
                  }
                }
                description
                  "Which.";
              }
              leaf threshold {
                type metric-value;
                description
                  "The threshold.";
              }
            }
          }
          choice rate {
            description
              "BANDWIDTH: a rate limiter, or a rate of its own.";
            leaf rate-limiter {
              type name;
              description
                "A rate limiter's name.";
            }
            container bandwidth {
              description
                "A commit and a limit (§7.15).";
              leaf commit {
                type uint64;
                units "bits/second";
                description
                  "The committed rate.";
              }
              leaf limit {
                type uint64;
                units "bits/second";
                description
                  "The limit.";
              }
            }
          }
          leaf af-security-ingress {
            type name;
            description
              "AF-SECURITY-INGRESS: a security policy.";
          }
          leaf af-security-egress {
            type name;
            description
              "AF-SECURITY-EGRESS: a security policy.";
          }
          leaf egress-block {
