  augment "/l3nm:l3vpn-ntw/l3nm:vpn-services/l3nm:vpn-service/"
        + "l3nm:vpn-instance-profiles/l3nm:vpn-instance-profile" {
    description
      "A routing domain of the SWVC (Mplify 119 §7.3, R15-R26): its RD
       and RTs are the profile's; the profile subscriber, the service's
       own table, is always there.";
    leaf domain {
      type enumeration {
        enum service {
          description
            "The service domain: the tunnels' addresses.";
        }
        enum breakout {
          description
            "The breakout domain: a table for the Internet.";
        }
        enum subscriber {
          description
            "The subscriber domain: the service's own table.";
        }
      }
      description
        "Which domain the document said.";
    }
    leaf fib {
      type fib;
      description
        "Its table (R20).";
    }
    leaf label {
      type uint32 {
        range "16..1048575";
      }
      description
        "Its MPLS label (R19).";
    }
    leaf prefix {
      type inet:ip-prefix;
      description
        "The service domain's prefix.";
    }
  }

  augment "/l3nm:l3vpn-ntw/l3nm:vpn-services/l3nm:vpn-service/"
        + "l3nm:vpn-nodes/l3nm:vpn-node/l3nm:vpn-network-accesses/"
        + "l3nm:vpn-network-access" {
    description
      "An SWVC End Point (MEF 70.2 §10) beyond L3NM's access.";
    container sdwan {
      description
        "The end point's attributes.";
      leaf uni-id {
        type name;
        description
          "Its SD-WAN UNI's id (§11).";
      }
      leaf host-addressed {
        type boolean;
        description
          "The host has the UNI's addresses already.";
      }
      leaf max-frame {
        type uint16 {
          range "1522..max";
        }
        units "bytes";
        description
          "The UNI's maximum frame (R126).";
      }
      container clat {
        presence "CLAT (RFC 6877).";
        description
          "The IPv4 hosts behind the UNI as IPv6 to the NAT64.";
        leaf prefix {
          type inet:ipv6-prefix;
          description
            "Its /96.";
        }
      }
      list policy-map {
        key "zone app";
        ordered-by user;
        description
          "Its policy map (§10.4).";
        leaf zone {
          type name;
          description
            "A zone, or Internet.";
        }
        leaf app {
          type name;
          description
            "An application flow or group.";
        }
        leaf ingress {
          type name;
          description
            "An ingress policy, or Block.";
        }
        leaf egress {
          type name;
          description
            "An egress policy.";
        }
      }
      container nat {
        presence "NAT (§10.5).";
        description
          "Its NAT.";
        choice nat {
          description
            "Disabled, or how.";
          leaf disabled {
            type empty;
            description
              "Disabled.";
          }
          case enabled {
            leaf ip-version {
              type family;
              description
                "Its families.";
            }
            leaf public-prefix {
              type inet:ipv4-prefix;
              description
                "The public prefix.";
            }
            leaf-list exception {
              type inet:ip-prefix;
              ordered-by user;
              description
                "Not translated.";
            }
          }
        }
      }
      leaf availability {
        type decimal64 {
          fraction-digits 6;
          range "0..max";
        }
        description
          "Its availability objective.";
      }
      container remote {
        presence "A remote end point: identities by WireGuard.";
        description
          "No UNI: a wg(4) interface of the edge in the service's
           table; L3NM's interface-id is it.";
        leaf prefix {
          type inet:ip-prefix;
          description
            "Where the identities' addresses come from.";
        }
        leaf port {
          type inet:port-number;
          description
            "The port it listens on.";
        }
        leaf reauth {
          type uint32 {
            range "3600..31622400";
          }
          units "seconds";
          description
            "How long an identity is authorised for.";
        }
        list group {
          key "name";
          ordered-by user;
          description
            "A group of identities.";
          leaf name {
            type name;
            description
              "Its name.";
          }
          leaf zone {
            type name;
            description
              "The zone its members' flows are of.";
          }
          leaf pool {
            type inet:ip-prefix;
            description
              "Where its members' addresses come from.";
          }
          leaf-list reach {
            type name;
            ordered-by user;
            description
              "The groups its members reach.";
          }
        }
        list identity {
          key "name";
          ordered-by user;
          description
            "An identity.";
          leaf name {
            type name;
            description
              "Its name.";
          }
          leaf zone {
            type name;
            description
              "Its zone, where it is in no group.";
          }
          leaf group {
            type name;
            description
              "Its group.";
          }
          leaf public-key {
            type string {
              pattern '[A-Za-z0-9+/]{43}=';
            }
            description
              "Its WireGuard public key.";
          }
          leaf issued {
            type int64;
            description
              "When it was issued, seconds since the epoch.";
          }
          leaf user {
            type boolean;
            description
              "A console user's.";
          }
        }
      }
    }
  }

  augment "/l3nm:l3vpn-ntw/l3nm:vpn-services/l3nm:vpn-service/"
