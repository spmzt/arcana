            type afs-value;
            ordered-by user;
            description
              "PROTV4.";
          }
          leaf-list nextheadv6 {
            type afs-value;
            ordered-by user;
            description
              "NEXTHEADV6.";
          }
          leaf-list dscp {
            type inet:dscp;
            ordered-by user;
            description
              "DSCP.";
          }
