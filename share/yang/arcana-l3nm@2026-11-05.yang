          description
            "Intrusion detection, Arcana's own.";
          leaf mode {
            type enumeration {
              enum detect {
                description
                  "Watching.";
              }
              enum prevent {
                description
                  "In the way.";
              }
            }
            description
              "Its mode.";
          }
          leaf ruleset {
            type boolean;
            description
              "suricata-update's rules too.";
          }
          leaf-list rule {
            type string {
              length "1..4096";
            }
            ordered-by user;
            description
              "Its own rules.";
          }
        }
      }
      container importance {
