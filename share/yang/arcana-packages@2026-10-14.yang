module arcana-packages {
  yang-version 1.1;
  namespace "urn:arcana:yang:arcana-packages";
  prefix arcpkg;

  import ietf-netconf-acm {
    prefix nacm;
    reference
      "RFC 8341: Network Configuration Access Control Model";
  }

  import cblink-gen {
    prefix cg;
  }
  import arcana-jails {
    prefix arcj;
  }

  organization
    "Arcana";
  contact
    "Pouria Mousavizadeh Tehrani <pouria@FreeBSD.org>";
  description
    "FreeBSD's packages (pkg(8)): those installed on the host, or in a
     running jail, as pkg's own database has them (pkg query), each
     with the version its repository has where that is newer (pkg
     version -vRl '<'); the catalogue refreshed (pkg update) and
     packages upgraded (pkg upgrade) as actions.

     A jail's packages are the jail's: arcana-jails's jail has them.";

  revision 2026-10-14 {
    description
      "Initial revision.";
  }

  typedef ip-version {
    type enumeration {
      enum any {
        value 0;
        description
          "pkg's own choice.";
      }
      enum ipv4 {
        value 4;
        description
          "pkg -4.";
      }
      enum ipv6 {
        value 6;
        description
          "pkg -6.";
      }
    }
    description
      "How pkg reaches its repository.";
  }

  grouping package {
    description
      "A package.";
    leaf name {
      type string;
      description
        "Its name (pkg's name, without its version).";
    }
    leaf installed {
      type string;
      description
        "The version installed.";
    }
    leaf available {
      type string;
      description
        "A newer version the repository has, when it was asked.";
    }
    leaf automatic {
      type boolean;
      description
        "Whether it came as another's dependency (pkg's automatic
         flag).";
    }
    leaf comment {
      type string;
      description
        "Its one-line description.";
    }
    leaf size {
      type uint64;
      units "bytes";
      description
        "What it takes installed.";
    }
    leaf origin {
      type string;
      description
        "Its port, category/name.";
    }
  }

  grouping packages {
    description
      "The packages of a host or of a jail, and what is done to them.";
    container packages {
      cg:struct "packages";
      config false;
      description
        "Its packages.";
      list package {
        cg:struct "package";
        key "name";
        description
          "An installed package.";
        uses package;
      }
      leaf-list repository {
        type string;
        description
          "The repositories pkg is configured with there (pkg -vv),
           enabled or not: an upgrade may be held to any of them.";
      }
      action refresh {
        nacm:default-deny-all;
        description
          "pkg update: the repository's catalogue read again, and what
           it has newer.";
        input {
          leaf ip-version {
            type ip-version;
            default "any";
            description
              "How the repository is reached.";
          }
        }
      }
      action upgrade {
        nacm:default-deny-all;
        description
          "pkg upgrade -y, of the packages named or of all.";
        input {
          leaf-list name {
            type string;
            description
              "The packages; none, all of them.";
          }
          leaf dry-run {
            type boolean;
            default "false";
            description
              "Only what pkg would do (pkg upgrade -n).";
          }
          leaf ignore-osversion {
            type boolean;
            default "false";
            description
              "Packages built for a newer FreeBSD too
               (IGNORE_OSVERSION).";
          }
          leaf ip-version {
            type ip-version;
            default "any";
            description
              "How the repository is reached.";
          }
          leaf repository {
            type string;
            description
              "From this one of pkg's repositories alone (pkg upgrade
               -r); none, from where pkg's configuration has each.";
          }
        }
        output {
          leaf upgraded {
            type uint32;
            description
              "How many were upgraded, or would be.";
          }
          list package {
            cg:struct "package";
            key "name";
            description
              "Those upgraded, or that would be: the version before,
               and the one after as available.";
            uses package;
          }
        }
      }
    }
  }

  uses packages;

  augment "/arcj:jails/arcj:jail" {
    description
      "A running jail's packages.";
    uses packages;
  }
}
