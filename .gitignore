# Per-machine build settings (see config.mk.sample).
/config.mk

# Third-party builds and development state.
/build/

# Build products: everything goes to obj/, mirroring the tree
# (share/mk/jailgrid.mk), unless MAKEOBJDIRPREFIX says otherwise.
/obj/
*.core

# Left over from builds in the source directories before obj/ existed;
# "make clean" as the user who built them removes them.
*.o
*.pico
*.pieo
*.a
*.so
*.full
*.debug
*.wo
.depend*
jailgrid.[ch]
jailgrid_client.c
jailgrid_server.c

# Generated by bsd.test.mk; the top-level tests/Kyuafile is written by hand.
/*/*/tests/Kyuafile
