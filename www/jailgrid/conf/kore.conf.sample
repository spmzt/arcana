# kore(1) configuration for the jailgrid console.
#
#	JAILGRID_WEB_CONF=/usr/local/etc/jailgrid/web.conf \
#	    kore -c /usr/local/etc/jailgrid/kore.conf
#
# One worker: sessions and WebAuthn challenges live in its memory.
# Requests to jailgridd run on task threads.

server console {
	bind		0.0.0.0 443
	tls		yes
}

privsep worker {
	runas		jailgrid
	# Sockets of a local jailgridd and the data directory must stay
	# reachable, so no chroot.
	skip		chroot
}

load		/usr/local/lib/jailgrid/jailgrid.so jgw_onload
pidfile		/var/run/jailgrid.pid

workers			1
task_threads		8
http_body_max		65536
http_media_type		application/wasm wasm
http_media_type		application/manifest+json webmanifest
http_media_type		image/svg+xml svg
http_media_type		font/woff2 woff2
http_media_type		image/x-icon ico
filemap_index		index.html

# The certificate must be RSA: Kore's key manager signs nothing else.
domain console.example {
	attach		console
	certfile	/usr/local/etc/jailgrid/console.pem
	certkey		/usr/local/etc/jailgrid/console.key
	include		/usr/local/etc/jailgrid/routes.conf
	filemap		/ /usr/local/www/jailgrid
}
