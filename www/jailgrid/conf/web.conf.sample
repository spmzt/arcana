# The jailgrid console (jailgrid.so), in UCL.  Named by JAILGRID_WEB_CONF.

# WebAuthn relying party: the console's host name, and the exact origin
# the browser uses.  WebAuthn needs HTTPS except on localhost.
rp_id = "console.example";
rp_name = "Jailgrid";
origin = "https://console.example";

# Registered keys, servers and the one-time setup token.  Mode 0700,
# owned by the user the worker runs as.
datadir = "/var/db/jailgrid";

cookie_secure = true;

# Certificates for jailgridd over TCP.  Without this block the console
# runs a CA of its own in datadir and enrols hosts with it (see
# jailgrid-enrol(8)).  With it: the CA that issued the jailgridd
# certificates, the console's client certificate, and the CA's key if
# the console is still to enrol hosts.
#tls {
#	ca = "/usr/local/etc/jailgrid/ca.pem";
#	ca_key = "/usr/local/etc/jailgrid/ca.key";
#	cert = "/usr/local/etc/jailgrid/client.pem";
#	key = "/usr/local/etc/jailgrid/client.key";
#}
