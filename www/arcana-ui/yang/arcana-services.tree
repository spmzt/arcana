module: arcana-services
  +--rw services
     +--rw service* [name]
     |  +--rw name           string
     |  +--rw enabled?       boolean
     |  +--rw variable* [name]
     |  |  +--rw name     string
     |  |  +--rw value?   string
     |  +--ro path?          string
     |  +--ro rcvar?         string
     |  +--ro running?       boolean
     |  +--ro pid?           uint32
     |  +--ro status?        string
     |  +--ro description?   string
     |  +--ro command*       string
     |  +---x start
     |  |  +--ro output
     |  |     +--ro running?   boolean
     |  |     +--ro pid?       uint32
     |  |     +--ro status?    string
     |  +---x stop
     |  |  +--ro output
     |  |     +--ro running?   boolean
     |  |     +--ro pid?       uint32
     |  |     +--ro status?    string
     |  +---x restart
     |  |  +--ro output
     |  |     +--ro running?   boolean
     |  |     +--ro pid?       uint32
     |  |     +--ro status?    string
     |  +---x reload
     |  |  +--ro output
     |  |     +--ro running?   boolean
     |  |     +--ro pid?       uint32
     |  |     +--ro status?    string
     |  +---x read
     |     +--ro output
     |        +--ro enabled?       boolean
     |        +--ro path?          string
     |        +--ro rcvar?         string
     |        +--ro running?       boolean
     |        +--ro pid?           uint32
     |        +--ro status?        string
     |        +--ro description?   string
     |        +--ro command*       string
     +---x convert
     |  +---w input
     |  |  +---w service*   string
     |  |  +---w dry-run?   boolean
     |  +--ro output
     |     +--ro service* [name]
     |        +--ro name    string
     |        +--ro variable* [name file line]
     |           +--ro name     string
     |           +--ro file     string
     |           +--ro line     uint32
     |           +--ro value?   string
     |           +--ro left?    string
     +---x release
        +---w input
        |  +---w service*   string
        |  +---w dry-run?   boolean
        +--ro output
           +--ro service* [name]
              +--ro name    string
              +--ro variable* [name]
                 +--ro name            string
                 +--ro arcana-value?   string
                 +--ro restored* [file line]
                 |  +--ro file     string
                 |  +--ro line     uint32
                 |  +--ro value?   string
                 +--ro dropped?        string
                 +--ro differs?        string
