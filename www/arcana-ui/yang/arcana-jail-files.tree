module: arcana-jail-files

  augment /arcj:jails:
    +---x read-files
       +--ro output
          +--ro directory?   string
          +--ro defaults
          |  +--ro path?   string
          |  +--ro text?   string
          +--ro template* [name]
          |  +--ro name    string
          |  +--ro text?   string
          +--ro jail* [name]
             +--ro name    string
             +--ro text?   string
