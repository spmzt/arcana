module: arcana-interfaces

  augment /if:interfaces/if:interface:
    +--ro driver-name?              string
    +--rw group*                    string
    +--rw tunnel-fib?               uint32
    +--rw capabilities?             capabilities
    +--ro capabilities-supported?   capabilities
    +--rw media
    |  +--rw current
    |  |  +---u media-word
    |  +--ro active
    |  |  +---u media-word
    |  +--ro status?      enumeration
    |  +--ro supported*   string
    +--ro peer-vnet?                boolean
  augment /if:interfaces/if:interface/dot1ax:lag:
    +--rw protocol?   enumeration
    +--rw hash?       bits
  augment /if:interfaces/if:interface/dot1ax:aggport:
    +--ro priority?   uint32
    +--ro flags?      bits
  augment /if:interfaces/if:interface/dot1q:bridge-port:
    +--ro flags?   bits
  augment /if:interfaces/if:interface/if-ext:encapsulation/if-ext:encaps-type/if-vlan:dot1q-vlan/if-vlan:dot1q-vlan:
    +--rw pcp?   dot1q-types:priority-type
