     |     |  |  +--ro verdict?      enumeration
     |     |  |  +--ro rule?         arcfw:rule-number
     |     |  |  +--ro text?         string
     |     |  |  +--ro by-state?     boolean
     |     |  |  +--ro keep-state?   boolean
     |     |  |  +--ro setfib?       int32
     |     |  |  +--ro fwd?          string
     |     |  |  +--ro note?         string
