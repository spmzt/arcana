     |     |  +--ro metric?          uint32
     |     |  +--ro weight?          uint32
     |     +--ro neighbor
     |     |  +--ro address?   inet:ip-address-no-zone
     |     |  +--ro state?     string
     |     +--ro return
     |     |  +--ro fib?         uint16
     |     |  +--ro interface?   string
     |     |  +--ro gateway?     string
     |     |  +--ro symmetric?   boolean
     |     +--ro firewall
     |     |  +--ro on?          boolean
     |     |  +--ro in
     |     |  |  +--ro verdict?      enumeration
     |     |  |  +--ro rule?         arcfw:rule-number
     |     |  |  +--ro text?         string
     |     |  |  +--ro by-state?     boolean
     |     |  |  +--ro keep-state?   boolean
     |     |  |  +--ro setfib?       int32
