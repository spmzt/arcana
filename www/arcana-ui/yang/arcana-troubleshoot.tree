     |     +--ro finding*
     |        +--ro severity?   severity
     |        +--ro what?       string
     +---x traceroute
     |  +---w input
     |  |  +---w address    inet:ip-address-no-zone
     |  +--ro output
     |     +--ro address?   inet:ip-address-no-zone
     |     +--ro family?    enumeration
     |     +--ro reached?   boolean
     |     +--ro hop* [ttl]
     |        +--ro ttl        uint8
     |        +--ro address?   inet:ip-address-no-zone
     |        +--ro rtt?       decimal64
     |        +--ro note?      string
     |        +--ro lost?      boolean
     +---x capture
        +---w input
        |  +---w interface?   string
        |  +---w filter?      string
        |  +---w packets?     uint16
        |  +---w seconds?     uint8
        |  +---w jail?        string
        +--ro output
           +--ro source?           string
           +--ro filter?           string
           +--ro line*             string
           +--ro packets?          uint32
           +--ro limit?            uint16
           +--ro seconds?          uint8
           +--ro timed-out?        boolean
           +--ro bytes?            uint64
           +--ro pcap?             binary
           +--ro taken?            yang:date-and-time
           +--ro capture-source*   string
