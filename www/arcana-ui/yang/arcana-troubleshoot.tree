module: arcana-troubleshoot
  +--rw troubleshoot
     +--ro capture-source*   string
     +---x path-check
     |  +---w input
     |  |  +---w source         inet:ip-address-no-zone
     |  |  +---w destination    inet:ip-address-no-zone
