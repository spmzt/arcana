          |     +---- severity?      string
          |     +---- object?        string
          |     +---- by?            string
          |     +---- description?   string
          |     +---- state?         enumeration
          +--:(security)
          |  +---- security
          |     +---- sequence?      uint64
          |     +---- rule?          uint32
          |     +---- action?        string
          |     +---- source?        string
          |     +---- destination?   string
          |     +---- interface?     string
          |     +---- comment?       string
          +--:(job)
          |  +---- job
          |     +---- id?      uint64
          |     +---- title?   string
          |     +---- ok?      boolean
          |     +---- error?   string
          +--:(jail-state)
          |  +---- jail-state
          |     +---- jail?    string
          |     +---- state?   enumeration
          |     +---- jid?     uint32
          +--:(crash)
          |  +---- crash
          |     +---- pid?       uint32
          |     +---- process?   string
          |     +---- jid?       uint32
          |     +---- jail?      string
          |     +---- uid?       uint32
          |     +---- signal?    uint8
          |     +---- core?      boolean
          |     +---- reason?    string
          +--:(conf)
          |  +---- conf
          |     +---- file?   string
          +--:(device)
          |  +---- device
          |     +---- cdev?    string
          |     +---- state?   string
          +--:(zfs)
          |  +---- zfs
          |     +---- type?   string
          |     +---- pool?   string
          +--:(procs)
          |  +---- procs
          |     +---- started?   uint32
          |     +---- exited?    uint32
          +--:(monitor)
          |  +---- monitor
          |     +---- id?          string
          |     +---- metric?      string
          |     +---- value?       decimal64
          |     +---- threshold?   decimal64
          |     +---- over?        boolean
          |     +---- interface?   string
          +--:(alert)
             +---- alert
                +---- instance?    string
                +---- time?        string
                +---- src?         string
                +---- sport?       uint16
