#!/bin/sh
#
# SPDX-License-Identifier: BSD-2-Clause
#
# PROVIDE: arcana_console
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# The arcana console, arcana-console(8).  In /etc/rc.conf:
#
# arcana_console_enable (bool):	Set to "YES" to run the console.
# arcana_console_web_conf (str):	Its configuration.
#				Default: %%PREFIX%%/etc/arcana/web.conf
# arcana_console_pidfile (str):	As web.conf's server { pidfile } says.
#				Default: /var/run/arcana-console.pid

. /etc/rc.subr

name="arcana_console"
rcvar="arcana_console_enable"

load_rc_config $name

: ${arcana_console_enable:="NO"}
: ${arcana_console_web_conf:="%%PREFIX%%/etc/arcana/web.conf"}
: ${arcana_console_pidfile:="/var/run/arcana-console.pid"}

command="%%PREFIX%%/sbin/arcana-console"
command_args="-d -c ${arcana_console_web_conf}"
pidfile="${arcana_console_pidfile}"
required_files="${arcana_console_web_conf}"

run_rc_command "$1"
