# The arcana console, arcana-console(8), in UCL.  Named by its -c, by
# ARCANA_WEB_CONF, or /usr/local/etc/arcana/web.conf.

# The server: where it listens, HTTPS, the user it runs as.  The
# certificate may be RSA or EC; it and its key are read as root.
server {
	listen = [ "0.0.0.0:443", "[::]:443" ];
	certfile = "/usr/local/etc/arcana/console.pem";
	certkey = "/usr/local/etc/arcana/console.key";
	#webroot = "/usr/local/www/arcana-console";
	#user = "arcana";
	# One task thread per call to a host under way: more for a larger
	# fleet, or for many pages open at once.
	#task_threads = 32;
	#body_max = 8388608;
	#pidfile = "/var/run/arcana-console.pid";
}

# WebAuthn relying party: the console's host name, and the exact origin
# the browser uses.  WebAuthn needs HTTPS except on localhost.
rp_id = "console.example";
rp_name = "Arcana";
origin = "https://console.example";

# Registered keys, servers and the one-time setup token.  Mode 0700,
# owned by the user the worker runs as.
datadir = "/var/db/arcana";

cookie_secure = true;

# Certificates for arcana-agent over TCP.  Without this block the console
# runs a CA of its own in datadir and enrols hosts with it (see
# arcana-enrol(8)).  With it: the CA that issued the arcana-agent
# certificates, the console's client certificate, and the CA's key if
# the console is still to enrol hosts.
#tls {
#	ca = "/usr/local/etc/arcana/ca.pem";
#	ca_key = "/usr/local/etc/arcana/ca.key";
#	cert = "/usr/local/etc/arcana/client.pem";
#	key = "/usr/local/etc/arcana/client.key";
#}

# The console asks GitHub's release feed for the newest version every
# few hours and says in the UI when there is one; it does not replace
# itself.  Turn the checks off, or point them elsewhere:
#update_check = false;
#update_url = "https://api.github.com/repos/spmzt/arcana/releases/latest";

# The arcana-agent sent to hosts when the console is asked to update
# them: by default the one installed with it.
#agent_binary = "/usr/local/sbin/arcana-agent";

# Or have a host build it: with a repository named here, a host's page
# offers "Build agent here", and what it builds is what the console
# sends from then on.
#agent_source = "https://github.com/spmzt/arcana.git";
#agent_ref = "main";
# Over SSH, a private key on the host that builds, readable by nobody;
# by default that host makes one and the console shows it to you.
#agent_ssh_key = "/usr/local/etc/arcana/git_ed25519";

# An Android app that may log in with the keys registered here: its
# package name, and the SHA-256 fingerprints of the certificates it is
# signed with ("apksigner verify --print-certs", or keytool).  The
# console then serves /.well-known/assetlinks.json naming it, and takes
# logins made in it, whose origin is android:apk-key-hash:...
#android {
#	package = "io.github.spmzt.arcana";
#	fingerprints = [ "AB:CD:...:EF" ];
#}

# Consoles that are one cluster, active on each node: the leader of
# their election (Raft over cblink) orders every change, each node keeps
# its copy, a majority must hold a change before it is made.  The first
# node named is the seed, whose documents the others are sent.  Copy
# the seed's ca.pem and ca.key into each node's datadir first; rp_id is
# then a name every origin is under (console.example).  See
# arcana-console(8).
#cluster {
#	self = "a";
#	listen = "tcp://[::]:4311";
#	nodes {
#		a { uri = "tcp://a.console.example:4311";
#		    origin = "https://a.console.example"; }
#		b { uri = "tcp://b.console.example:4311";
#		    origin = "https://b.console.example"; }
#		c { uri = "tcp://c.console.example:4311";
#		    origin = "https://c.console.example"; }
#	}
#}

# The agent of the host the console runs on is added to the list of
# servers by itself, once it answers on its local socket: start it with
# "service arcana_agent enable" and "service arcana_agent start", and
# have the console's user in the group of its socket (arcana_agent_group
# in rc.conf).  Taken off the list, it is not added again.  Another
# socket, or none:
#local_agent = "unix:/var/run/arcana-agent.sock";
#local_agent = "";

# A host's configured subscription (RFC 8639 section 2.5) sends its
# records to the console over HTTPS-notif, at /api/notif/<host>/ of a
# TLS listener, the host shown by its certificate.  The base the hosts
# reach the console by, when it is not the origin:
#notif_base = "https://console.example:8443";
